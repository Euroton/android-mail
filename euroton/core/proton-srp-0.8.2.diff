 #[cfg(feature = "pgpinternal")]
 pub use rpgp_impl::*;
 
+/// Key that replaces the built-in server key when verifying a modulus.
+/// Set by apps that talk to a self-hosted server with its own signing key.
+static MODULUS_KEY_OVERRIDE: std::sync::RwLock<Option<String>> = std::sync::RwLock::new(None);
+
+/// Replace (or with `None` restore) the key every modulus signature is checked against.
+pub fn set_modulus_verification_key(armored_public_key: Option<String>) {
+    let mut key = MODULUS_KEY_OVERRIDE.write().unwrap_or_else(std::sync::PoisonError::into_inner);
+    *key = armored_public_key;
+}
+
+fn modulus_key_override() -> Option<String> {
+    MODULUS_KEY_OVERRIDE.read().unwrap_or_else(std::sync::PoisonError::into_inner).clone()
+}
+
